// Herbal Holland commerce platform — data model.
// Money is stored in integer cents (ZAR). Retail prices are VAT-inclusive,
// wholesale/cost prices are VAT-exclusive. Stock is tracked per batch so every
// unit is traceable (FEFO picking, FIFO valuation, recalls).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Network ─────────────────────────────

enum CompanyKind {
  FRANCHISOR
  FRANCHISEE
}

enum StoreKind {
  RETAIL
  WAREHOUSE
}

enum StoreStatus {
  ACTIVE
  OPENING_SOON
  CLOSED
}

enum StoreFormat {
  FLAGSHIP
  STANDARD
  EXPRESS
}

enum Province {
  GP
  WC
  KZN
  EC
  FS
  LP
  MP
  NW
  NC
}

// Area-manager territories. A 1,000-store network is managed region by region.
model Region {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  stores Store[]
  users  User[]
}

model Company {
  id          String      @id @default(cuid())
  kind        CompanyKind
  name        String
  legalName   String
  regNumber   String?
  vatNumber   String?
  contactName String?
  email       String?
  phone       String?
  address     String?
  directors   String? // names of the directors, as the website must disclose them (ECTA s43)
  // Books (the company's general ledger): months up to this one are closed; VAT category A/B (two-monthly) or C
  // (monthly), null when not a VAT vendor; the financial year ends with this month (February is the SA default).
  booksLockedThrough String? // YYYY-MM
  vatCategory        String?
  yearEndMonth       Int     @default(2)
  stores      Store[]
  users       User[]
  createdAt   DateTime    @default(now())
}

model Store {
  id            String      @id @default(cuid())
  code          String      @unique
  slug          String      @unique
  name          String
  kind          StoreKind   @default(RETAIL)
  status        StoreStatus @default(ACTIVE)
  format        StoreFormat @default(STANDARD)
  company       Company     @relation(fields: [companyId], references: [id])
  companyId     String
  region        Region      @relation(fields: [regionId], references: [id])
  regionId      String
  dc            Store?      @relation("dc", fields: [dcId], references: [id])
  dcId          String? // serving distribution centre (WAREHOUSE)
  served        Store[]     @relation("dc")
  addressLine   String
  suburb        String
  city          String
  province      Province
  postalCode    String
  lat           Float?
  lng           Float?
  phone         String?
  whatsapp      String?
  email         String?
  hours         Json?
  clickCollect  Boolean     @default(true)
  payshapId     String? // the ShapID the store's bank issued; the till offers PayShap only when it's set
  sameDay       Boolean     @default(false)
  licences      RegClass[]  @default([]) // classes this store is licensed/permitted to sell
  licenceRef    String? // e.g. SAHPRA licence / permit numbers, printed on receipts
  royaltyBps    Int         @default(600)
  levyBps       Int         @default(200)
  ecomBps       Int         @default(1000)
  receiptFooter String?
  commissionOn  Boolean     @default(false) // staff commission, switched on by the owner (who pays it)
  openedAt      DateTime?
  createdAt     DateTime    @default(now())

  users          User[]
  events         StoreEvent[]
  devices        Device[]
  stock          StockLevel[]
  storeVariants  StoreVariant[]
  movements      StockMovement[]
  sales          Sale[]
  shifts         Shift[]
  orders         Order[]
  purchases      StockOrder[]       @relation("buyer")
  supplies       StockOrder[]       @relation("seller")
  listings       Listing[]
  stockTakes     StockTake[]
  expenses       Expense[]
  customers      Customer[]
  loyalty        LoyaltyEntry[]
  campaigns      Campaign[]
  dailyStats     DailyStoreStat[]
  tradeOrders    TradeOrder[]       @relation("tradeStore")
  variantStats   DailyVariantStat[]
  acks           AnnouncementAck[]
  deposits       CashDeposit[]
  alerts         Alert[]
  commissionRuns CommissionRun[]

  @@index([regionId])
  @@index([companyId])
}

enum Role {
  HQ_ADMIN
  HQ_STAFF
  AREA_MANAGER
  OWNER
  MANAGER
  BUDTENDER
  ACCOUNTANT // a company's bookkeeper: its books (/books) only — no store, POS or HQ pages
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String?   @unique
  passwordHash       String?
  mustChangePassword Boolean   @default(false) // set with a temporary password; cleared when they choose their own
  tempPasswordUntil  DateTime? // a temporary password stops working after this (HQ resets; the owner sets one for staff)
  pinHash            String?
  passwordFails      Int       @default(0) // wrong passwords since the last lock or sign-in (sign-in and till pairing)
  passwordLockedAt   DateTime? // locked out until 15 minutes after this
  pinFails           Int       @default(0)
  pinLockedAt        DateTime? // locked out of every till until 5 minutes after this
  pinDisabledAt      DateTime? // ten wrong PINs in a day: off until a manager sets a new one
  canDispense        Boolean   @default(false) // responsible pharmacist / authorised dispenser for licensed products
  memberId           String?   @unique // their own Rewards membership: sales they ring onto it are flagged and earn no commission
  role               Role
  company            Company?  @relation(fields: [companyId], references: [id])
  companyId          String?
  store              Store?    @relation(fields: [storeId], references: [id])
  storeId            String?
  region             Region?   @relation(fields: [regionId], references: [id])
  regionId           String?
  active             Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  sessions Session[]
  sales    Sale[]

  @@index([storeId])
  @@index([companyId])
}

model Session {
  id           String      @id // sha256(token)
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String?
  storeId      String? // POS store context
  deviceId     String?
  tradeBuyer   TradeBuyer? @relation(fields: [tradeBuyerId], references: [id], onDelete: Cascade)
  tradeBuyerId String? // trade portal session (cookie hh_trade)
  expiresAt    DateTime
  lastSeenAt   DateTime    @default(now()) // staff sessions end after a stretch without use (src/server/auth.ts)
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([customerId])
  @@index([tradeBuyerId])
  @@index([expiresAt])
}

model Device {
  id         String    @id @default(cuid())
  store      Store     @relation(fields: [storeId], references: [id])
  storeId    String
  name       String
  prefix     String // receipt-number prefix, unique per store
  seq        Int       @default(0)
  tokenHash  String    @unique
  active     Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([storeId, prefix])
}

// ───────────────────────────── Catalogue ─────────────────────────────

enum StrainType {
  INDICA
  SATIVA
  HYBRID
  CBD
}

enum RegClass {
  THC // licence-gated: unsellable until a store holds a licence under a future regime
  CBD // CBD supplements — Schedule 0 complementary medicines (oils, softgels): ≤ 20 mg a day, ≤ 600 mg a pack
  CBD_FOOD // CBD food & drink (coffee, tea, protein): ≤ 0.0075% CBD, naturally occurring only (GN 586 of 2020)
  CBD_TOPICAL // CBD skin care (creams, balms)
  HEMP
  SUPPLEMENT // supplements without cannabis (collagen, protein)
  ACCESSORY
  APPAREL
  GROW
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  blurb     String?
  icon      String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  tagline        String?
  brand          String        @default("Herbal Holland")
  line           String? // HOUSE | HERITAGE | CLASSIC | PARTNER
  category       Category      @relation(fields: [categoryId], references: [id])
  categoryId     String
  description    String
  strain         StrainType?
  thcMin         Float?
  thcMax         Float?
  cbdMin         Float?
  cbdMax         Float?
  terpenes       Json? // [{ name, pct }]
  effects        String[]      @default([])
  flavours       String[]      @default([])
  lineage        String?
  origin         String?
  heritage       Boolean       @default(false)
  regClass       RegClass
  // Compliance master data
  legalBasis     String? // e.g. "Schedule 0 CBD — GN 586 of 2020"
  cbdMgPerPack   Int? // Schedule 0: ≤ 600 mg per sales pack
  cbdMgPerDay    Float? // Schedule 0: ≤ 20 mg maximum daily dose
  claims         String[]      @default([]) // approved low-risk claims only
  // Food, supplement and skin-care facts (members see them on the product page and at the till)
  netContent     Float? // one pack, in netUnit
  netUnit        String? // "g" | "ml"
  ingredients    String?
  allergens      String[]      @default([]) // keys from @/lib/compliance ALLERGENS
  naturalCbd     Boolean       @default(false) // CBD food & drink: only the CBD naturally in the ingredients
  tobaccoRelated Boolean       @default(false) // pipes, water-pipes, papers, vapes (Tobacco Bill B33-2022)
  featured       Boolean       @default(false)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  variants Variant[]
  reviews  Review[]

  // Shop search: typo-tolerant matching on the name and tagline (pg_trgm similarity).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([tagline(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Variant {
  id             String  @id @default(cuid())
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  sku            String  @unique
  barcode        String? @unique
  name           String
  grams          Float? // dried-flower equivalent grams, used for purchase limits
  priceCents     Int // national RRP, VAT incl.
  wholesaleCents Int // price to stores and the trade fallback price, VAT excl.
  caseQty        Int     @default(1) // units per case: trade orders are placed in multiples of this
  costCents      Int // HQ landed cost, VAT excl. (made to order: the print partner's price)
  podSku         String? // print partner's product code: set = made to order (no stock; ships from the partner)
  active         Boolean @default(true)
  sortOrder      Int     @default(0)

  batches         Batch[]
  stock           StockLevel[]
  storeVariants   StoreVariant[]
  movements       StockMovement[]
  saleLines       SaleLine[]
  orderLines      OrderLine[]
  stockOrderLines StockOrderLine[]
  tradeOrderLines TradeOrderLine[]
  listings        Listing[]
  stockTakeLines  StockTakeLine[]
  alerts          StockAlert[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum BatchStatus {
  RELEASED
  QUARANTINE
  RECALLED
}

model Batch {
  id           String      @id @default(cuid())
  code         String      @unique
  variant      Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId    String
  supplier     String
  packedAt     DateTime
  expiresAt    DateTime?
  thc          Float?
  cbd          Float?
  labName      String?
  coaRef       String?
  labResults   Json? // { microbials, pesticides, heavyMetals, residualSolvents, terpenes: [{ name, pct }] }
  status       BatchStatus @default(RELEASED)
  statusReason String?
  createdAt    DateTime    @default(now())

  stock     StockLevel[]
  movements StockMovement[]

  @@index([variantId])
}

// ───────────────────────────── Inventory ─────────────────────────────

model StockLevel {
  id            String   @id @default(cuid())
  store         Store    @relation(fields: [storeId], references: [id])
  storeId       String
  variant       Variant  @relation(fields: [variantId], references: [id])
  variantId     String
  batch         Batch    @relation(fields: [batchId], references: [id])
  batchId       String
  onHand        Int      @default(0)
  unitCostCents Int // landed cost of this batch at this store, VAT excl.
  updatedAt     DateTime @updatedAt

  @@unique([storeId, variantId, batchId])
  @@index([storeId, variantId])
  @@index([variantId])
}

model StoreVariant {
  store        Store   @relation(fields: [storeId], references: [id])
  storeId      String
  variant      Variant @relation(fields: [variantId], references: [id])
  variantId    String
  priceCents   Int? // local shelf price (franchisees set their own prices)
  reorderPoint Int     @default(4)
  parLevel     Int     @default(12)

  // A row here means the variant is ranged at the store.
  @@id([storeId, variantId])
  @@index([variantId])
}

enum MovementType {
  RECEIVE
  SALE
  REFUND
  ONLINE
  ADJUST
  COUNT
  TRANSFER_OUT
  TRANSFER_IN
}

enum AdjustReason {
  DAMAGED
  EXPIRED
  THEFT
  LOST
  SAMPLE
  QUALITY
  FOUND
  RECALL
  DESTROYED
  CORRECTION
}

model StockMovement {
  id            String        @id @default(cuid())
  store         Store         @relation(fields: [storeId], references: [id])
  storeId       String
  variant       Variant       @relation(fields: [variantId], references: [id])
  variantId     String
  batch         Batch         @relation(fields: [batchId], references: [id])
  batchId       String
  qty           Int // signed
  type          MovementType
  reason        AdjustReason?
  unitCostCents Int
  revalueCents  Int           @default(0) // what the lot's value changed by beyond qty × unitCostCents (its cost re-averaged)
  note          String?
  saleId        String?
  orderId       String?
  stockOrderId  String?
  stockTakeId   String?
  userId        String?
  createdAt     DateTime      @default(now())

  @@index([storeId, createdAt])
  @@index([variantId])
  @@index([batchId])
}

enum StockTakeStatus {
  COUNTING
  APPROVED
  CANCELLED
}

model StockTake {
  id           String          @id @default(cuid())
  number       String          @unique
  store        Store           @relation(fields: [storeId], references: [id])
  storeId      String
  scope        String // "FULL" or a category slug for cycle counts
  blind        Boolean         @default(true)
  status       StockTakeStatus @default(COUNTING)
  createdById  String?
  approvedById String?
  notes        String?
  createdAt    DateTime        @default(now())
  approvedAt   DateTime?
  lines        StockTakeLine[]
}

model StockTakeLine {
  id            String    @id @default(cuid())
  stockTake     StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  stockTakeId   String
  variant       Variant   @relation(fields: [variantId], references: [id])
  variantId     String
  batchId       String
  expectedQty   Int
  countedQty    Int?
  varianceQty   Int?
  unitCostCents Int

  @@unique([stockTakeId, variantId, batchId])
}

// Stores buy stock from HQ (WHOLESALE) or from each other (NETWORK).
enum StockOrderKind {
  WHOLESALE
  NETWORK
}

enum StockOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SHIPPED
  RECEIVED
  REJECTED
  CANCELLED
}

model StockOrder {
  id            String           @id @default(cuid())
  number        String           @unique
  kind          StockOrderKind
  status        StockOrderStatus @default(DRAFT)
  buyer         Store            @relation("buyer", fields: [buyerId], references: [id])
  buyerId       String
  seller        Store            @relation("seller", fields: [sellerId], references: [id])
  sellerId      String
  subtotalCents Int              @default(0)
  vatCents      Int              @default(0)
  totalCents    Int              @default(0)
  notes         String?
  createdById   String?
  createdAt     DateTime         @default(now())
  submittedAt   DateTime?
  approvedAt    DateTime?
  shippedAt     DateTime?
  receivedAt    DateTime?
  invoiceSentAt DateTime?
  lines         StockOrderLine[]

  @@index([buyerId, status])
  @@index([sellerId, status])
}

model StockOrderLine {
  id            String     @id @default(cuid())
  stockOrder    StockOrder @relation(fields: [stockOrderId], references: [id], onDelete: Cascade)
  stockOrderId  String
  variant       Variant    @relation(fields: [variantId], references: [id])
  variantId     String
  qty           Int
  unitCostCents Int // VAT excl.
  shipped       Json? // [{ batchId, qty }]
  receivedQty   Int?

  @@index([stockOrderId])
}

model Listing {
  id            String   @id @default(cuid())
  store         Store    @relation(fields: [storeId], references: [id])
  storeId       String
  variant       Variant  @relation(fields: [variantId], references: [id])
  variantId     String
  qty           Int
  unitCostCents Int // asking price, VAT excl.
  note          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([active, variantId])
}

// ───────────────────────────── Customers & loyalty ─────────────────────────────

enum Tier {
  SEED
  SPROUT
  BLOOM
  HARVEST
}

enum AgeCheck {
  NONE
  ID_SIGHTED // document sighted by staff (SA ID, passport)
  ID_NUMBER // number format + checksum only
  VERIFIED // live Home Affairs / vendor verification
}

model Customer {
  id                 String    @id @default(cuid())
  memberNo           String    @unique
  phone              String    @unique
  email              String?   @unique
  firstName          String
  lastName           String?
  dob                DateTime?
  idHash             String?   @unique
  idLast4            String?
  ageVerifiedAt      DateTime?
  ageCheck           AgeCheck  @default(NONE)
  tier               Tier      @default(SEED)
  tierFloor          Tier? // guaranteed minimum tier until tierFloorUntil (founding members start at Sprout)
  tierFloorUntil     DateTime?
  foundingNo         Int?      @unique // Founding Member number: waitlist place at launch
  personalisedOffers Boolean   @default(true) // POPIA: members may object to personalised offers (My Deals)
  homeStore          Store?    @relation(fields: [homeStoreId], references: [id])
  homeStoreId        String?
  referralCode       String    @unique
  referredById       String?
  consentWhatsapp    Boolean   @default(false)
  consentSms         Boolean   @default(false)
  consentEmail       Boolean   @default(false)
  consentPush        Boolean   @default(false)
  consentAt          DateTime?
  source             String?
  joinedVia          String? // ?src= tag on the join link or QR code (e.g. qr-window-hillcrest)
  termsVersion       String? // membership terms accepted (TERMS_VERSION)
  termsAcceptedAt    DateTime?
  interests          String[]  @default([]) // what they told us they're into (INTERESTS), for relevant deals
  // Denormalised stats (kept current on every purchase) so segmentation stays
  // cheap across millions of members.
  points             Int       @default(0)
  lifetimeCents      Int       @default(0)
  visits             Int       @default(0)
  firstPurchaseAt    DateTime?
  lastPurchaseAt     DateTime?
  createdAt          DateTime  @default(now())
  lastSeenAt         DateTime?

  sessions      Session[]
  loyalty       LoyaltyEntry[]
  sales         Sale[]
  orders        Order[]
  messages      MessageLog[]
  alerts        StockAlert[]
  reviews       Review[]
  consentEvents ConsentEvent[]
  patientAuths  PatientAuth[]
  pushSubs      PushSubscription[]
  offers        MemberOffer[]
  rsvps         Rsvp[]
  dropWatches   DropWatch[]
  quests        QuestCompletion[]

  @@index([homeStoreId])
  @@index([lastPurchaseAt])
  @@index([tier])
  @@index([referredById])
  @@index([createdAt])
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin) // member search: partial and misspelt names
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum LoyaltyKind {
  EARN
  REDEEM
  SIGNUP
  REFERRAL
  BIRTHDAY
  BONUS
  REVERSAL
  EXPIRE
  ADJUST
}

// Points ledger. Points are a network-wide liability settled between stores
// on the monthly franchise statement (issuing store funds, redeeming store is reimbursed).
model LoyaltyEntry {
  id         String      @id @default(cuid())
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  store      Store?      @relation(fields: [storeId], references: [id])
  storeId    String?
  points     Int
  kind       LoyaltyKind
  saleId     String?
  orderId    String?
  note       String?
  createdAt  DateTime    @default(now())

  @@index([customerId])
  @@index([storeId, createdAt])
}

// Medical pathway: SAHPRA Section 21 authorisation / prescription on file.
// The clinical condition is deliberately NOT stored (POPIA s26 special personal information).
enum AuthStatus {
  ACTIVE
  REVOKED
}

model PatientAuth {
  id                String     @id @default(cuid())
  customer          Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId        String
  authNumber        String
  prescriber        String
  prescriberRegNo   String // HPCSA registration number
  scope             String // authorised products, e.g. "Dried flower, oils"
  monthlyLimitGrams Float
  validFrom         DateTime
  validTo           DateTime
  documentRef       String? // reference to the scanned authorisation in document storage
  status            AuthStatus @default(ACTIVE)
  verifiedById      String?
  createdAt         DateTime   @default(now())

  @@index([customerId])
}

// POPIA s69 evidence: every grant/withdrawal of marketing consent, per channel.
model ConsentEvent {
  id         String     @id @default(cuid())
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  channel    MsgChannel
  granted    Boolean
  source     String // SIGNUP_WEB | POS | CLUB_APP | STOP_REPLY | ADMIN
  wording    String?
  createdAt  DateTime   @default(now())

  @@index([customerId])
}

// Do-not-contact list: NCC opt-out registry imports + refusals. Checked before every send.
model Suppression {
  id        String   @id @default(cuid())
  value     String // E.164 phone or lower-case email
  channel   String? // null = all channels
  source    String // NCC_REGISTRY | REFUSED | STOP_REPLY | COMPLAINT
  createdAt DateTime @default(now())

  @@unique([value, source])
  @@index([value])
}

model Otp {
  id        String   @id @default(cuid())
  phone     String? // members: a code by SMS
  email     String? // trade buyers: a code by email
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
  @@index([createdAt])
}

// Rate limits that must hold across servers (src/server/throttle.ts): one row per counted event under a key such as
// "signin-ip:<hash>" or "otp-sms:all", counted in a sliding window under an advisory lock, pruned daily.
model Throttle {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

// Gateway webhook events already handled (Peach, Yoco): a redelivery of the same event id changes nothing.
model PaymentEvent {
  gateway   String
  eventId   String
  createdAt DateTime @default(now())

  @@id([gateway, eventId])
  @@index([createdAt])
}

// ───────────────────────────── Selling ─────────────────────────────

enum SaleKind {
  SALE
  REFUND
}

enum Channel {
  POS
  ONLINE
  WHOLESALE // trade sales: the trade portal (DC-fulfilled) and trade sales rung up at a till
}

enum PayMethod {
  CARD
  CASH
  PAYSHAP
  EFT
  LOYALTY
  ONLINE
  VOUCHER // a gift voucher: redeemed online at checkout or at the till (refunds go back onto the voucher)
  ACCOUNT // a trade account's credit terms: invoiced, settled later (never money at the time of sale)
}

model Shift {
  id                String       @id @default(cuid())
  store             Store        @relation(fields: [storeId], references: [id])
  storeId           String
  deviceId          String?
  openedById        String
  openedAt          DateTime     @default(now())
  openingFloatCents Int
  closedById        String?
  closedAt          DateTime?
  expectedCashCents Int?
  countedCashCents  Int?
  notes             String?
  deposit           CashDeposit? @relation(fields: [depositId], references: [id])
  depositId         String? // the bank deposit its cash went into
  sales             Sale[]

  @@index([storeId, closedAt])
  @@index([depositId, storeId]) // cash waiting to be banked (depositId null), and a deposit's cash-ups
}

model Sale {
  id                 String        @id // client-generated UUID (idempotent offline sync)
  number             String        @unique
  kind               SaleKind      @default(SALE)
  refundOf           Sale?         @relation("refunds", fields: [refundOfId], references: [id])
  refundOfId         String?
  refunds            Sale[]        @relation("refunds")
  channel            Channel       @default(POS)
  order              Order?        @relation(fields: [orderId], references: [id])
  orderId            String?       @unique
  store              Store         @relation(fields: [storeId], references: [id])
  storeId            String
  shift              Shift?        @relation(fields: [shiftId], references: [id])
  shiftId            String?
  staff              User?         @relation(fields: [staffId], references: [id])
  staffId            String?
  soldById           String? // who built the basket when a dispenser completed the sale (commission credit); null = staffId
  deviceId           String?
  customer           Customer?     @relation(fields: [customerId], references: [id])
  customerId         String?
  tradeAccount       TradeAccount? @relation(fields: [tradeAccountId], references: [id])
  tradeAccountId     String? // WHOLESALE channel: the business that bought (buyer block = its details)
  tradeOrder         TradeOrder?
  subtotalCents      Int
  discountCents      Int           @default(0)
  memberSavingsCents Int           @default(0)
  totalCents         Int
  vatCents           Int
  costCents          Int
  pointsEarned       Int           @default(0)
  promoCode          String?
  promotionId        String?
  campaignId         String?
  ageCheck           AgeCheck      @default(NONE)
  buyer              Json? // full tax invoice (> R5,000): { name, address, vatNumber }
  invoiceEmail       String? // where the tax invoice was emailed
  invoiceSentAt      DateTime?
  offline            Boolean       @default(false)
  note               String?
  createdAt          DateTime      @default(now())
  syncedAt           DateTime      @default(now())

  lines    SaleLine[]
  payments Payment[]

  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([tradeAccountId])
  @@index([createdAt])
  @@index([promotionId]) // promotion usage caps (maxUses) and redemption reporting
}

model SaleLine {
  id                 String  @id @default(cuid())
  sale               Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId             String
  variant            Variant @relation(fields: [variantId], references: [id])
  variantId          String
  qty                Int
  unitPriceCents     Int
  discountCents      Int     @default(0)
  memberSavingsCents Int     @default(0) // instant Rewards savings vs the non-member price
  offerCents         Int     @default(0) // My Deals discount (HQ-funded)
  totalCents         Int
  vatCents           Int
  costCents          Int
  allocations        Json // [{ batchId, qty, unitCostCents }]

  @@index([saleId])
  @@index([variantId])
}

model Payment {
  id            String    @id @default(cuid())
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId        String
  method        PayMethod
  amountCents   Int
  tenderedCents Int?
  changeCents   Int?
  provider      String?
  reference     String?
  cardBrand     String?
  cardLast4     String?
  createdAt     DateTime  @default(now())

  @@index([saleId])
}

enum Fulfilment {
  COLLECT
  SAME_DAY
  COURIER
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  PICKING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Order {
  id             String        @id @default(cuid())
  code           String        @unique
  customer       Customer      @relation(fields: [customerId], references: [id])
  customerId     String
  store          Store         @relation(fields: [storeId], references: [id])
  storeId        String
  status         OrderStatus   @default(PLACED)
  fulfilment     Fulfilment
  routingNote    String?
  addressLine    String?
  suburb         String?
  city           String?
  province       Province?
  postalCode     String?
  deliveryNotes  String?
  subtotalCents  Int
  discountCents  Int           @default(0)
  deliveryCents  Int           @default(0)
  pointsRedeemed Int           @default(0)
  totalCents     Int
  vatCents       Int
  payMethod      PayMethod
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentRef     String?
  collectionCode String
  idChecked      Boolean       @default(false) // 18+ ID check recorded at handover / proof of delivery
  courier        String?
  trackingNo     String?
  podRef         String? // print partner's order id for made-to-order lines
  podStatus      String? // partner's last reported status
  podTracking    String? // merch parcel's courier and tracking number ("Aramex · ARX123")
  promoCode      String?
  promotionId    String?
  campaignId     String?
  events         Json // [{ status, at, note }]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?

  lines OrderLine[]
  sale  Sale?

  @@index([storeId, status])
  @@index([customerId])
  @@index([createdAt])
  @@index([promotionId, status]) // promotion caps count open orders too (pricing.promotionProblem)
}

model OrderLine {
  id                 String  @id @default(cuid())
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId            String
  variant            Variant @relation(fields: [variantId], references: [id])
  variantId          String
  qty                Int
  unitPriceCents     Int
  memberSavingsCents Int     @default(0)
  offerCents         Int     @default(0)
  totalCents         Int

  @@index([orderId])
}

// ───────────────────────────── Finance ─────────────────────────────

enum ExpenseCategory {
  RENT
  SALARIES
  UTILITIES
  SECURITY
  MARKETING
  SUPPLIES
  BANK_FEES
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  store       Store           @relation(fields: [storeId], references: [id])
  storeId     String
  date        DateTime
  category    ExpenseCategory
  description String
  supplier    String?
  amountCents Int // VAT incl.
  vatCents    Int             @default(0)
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([storeId, date])
}

// ───────────────────────────── Pricing ─────────────────────────────
// Price lists layer on top of the national RRP: regional zones and scheduled
// changes, channel prices, member/tier prices and quantity breaks. A franchisee's
// own shelf price (StoreVariant.priceCents) always wins in store.

enum PriceListKind {
  ZONE // regional / scheduled price changes (stores or regions; empty = network)
  CHANNEL // e.g. online-only prices
  MEMBER // Rewards member prices, optionally tier-specific
  TRADE // trade (wholesale) prices for the WHOLESALE channel — items hold ex-VAT prices; quantity breaks via minQty
}

model PriceList {
  id            String          @id @default(cuid())
  name          String
  kind          PriceListKind
  channel       Channel?
  tiers         Tier[]          @default([]) // MEMBER: empty = all members
  storeIds      String[]        @default([])
  regionIds     String[]        @default([])
  adjustPct     Float? // blanket adjustment on RRP for items without an explicit price (e.g. -5)
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean         @default(true)
  priority      Int             @default(0)
  createdAt     DateTime        @default(now())
  items         PriceListItem[]
  tradeAccounts TradeAccount[]
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  priceListId String
  variantId   String
  priceCents  Int // VAT incl.
  minQty      Int       @default(1) // quantity breaks

  @@unique([priceListId, variantId, minQty])
  @@index([variantId])
}

// ───────────────────────────── Marketing ─────────────────────────────

enum PromoKind {
  PERCENT // % off qualifying items
  FIXED // R off per qualifying item, or off the basket when untargeted
  MULTIPLIER // Points multiplier (x100)
  BUY_X_GET_Y // bonus buys, BOGO, gifts with purchase, complementary deals
  MULTIBUY // mix & match: any N qualifying items for a set price
}

model Promotion {
  id                String    @id @default(cuid())
  name              String
  description       String?
  code              String?   @unique
  kind              PromoKind
  value             Int // PERCENT: whole %, FIXED: cents, MULTIPLIER: x100, MULTIBUY: bundle price in cents
  // Qualifying items (both empty = everything)
  categoryIds       String[]  @default([])
  productIds        String[]  @default([])
  minSpendCents     Int       @default(0)
  // BUY_X_GET_Y / MULTIBUY
  buyQty            Int? // qualifying units needed (null = the min spend alone triggers)
  getQty            Int? // reward units per trigger
  rewardPercent     Int? // % off reward units (100 = free)
  rewardCategoryIds String[]  @default([]) // reward items (both empty = same as qualifying items)
  rewardProductIds  String[]  @default([])
  channels          Channel[] @default([])
  storeIds          String[]  @default([]) // empty = whole network
  ownerStoreId      String? // null = HQ promotion
  startsAt          DateTime
  endsAt            DateTime
  days              Int[]     @default([]) // 0 = Sunday … 6 = Saturday; empty = every day
  startMinute       Int? // happy hours: minutes after midnight SAST
  endMinute         Int?
  active            Boolean   @default(true)
  maxUses           Int?
  firstPurchaseOnly Boolean   @default(false) // welcome gifts: a member's first purchase only
  createdAt         DateTime  @default(now())
}

enum MsgChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

model Campaign {
  id              String         @id @default(cuid())
  name            String
  channel         MsgChannel
  segment         String
  store           Store?         @relation(fields: [storeId], references: [id])
  storeId         String?
  message         String
  promotionId     String?
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  costCents       Int            @default(0) // spend drawn from the marketing fund
  audienceCount   Int            @default(0)
  sentCount       Int            @default(0)
  suppressedCount Int            @default(0)
  createdAt       DateTime       @default(now())
  messages        MessageLog[]
}

model MessageLog {
  id         String     @id @default(cuid())
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?
  to         String
  channel    MsgChannel
  kind       String // MARKETING | TRANSACTIONAL
  status     String // SENT | SUPPRESSED | FAILED
  reason     String?
  body       String
  createdAt  DateTime   @default(now())

  @@index([campaignId])
  @@index([customerId])
  @@index([createdAt])
  @@index([channel, status, createdAt])
}

model StockAlert {
  id         String    @id @default(cuid())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  variant    Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId  String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([customerId, variantId])
}

model Review {
  id             String    @id @default(cuid())
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId     String
  rating         Int
  title          String?
  body           String?
  verified       Boolean   @default(false)
  // Photos (Upload ids, up to 3) and HQ moderation: a hidden review stays on record but is never shown or counted.
  photoUploadIds String[]  @default([])
  hidden         Boolean   @default(false)
  hiddenReason   String?
  moderatedById  String?
  moderatedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([productId, customerId])
  @@index([hidden, createdAt])
}

// ───────────────────────────── Rollups ─────────────────────────────
// Maintained in the same transaction as every sale/refund (INSERT … ON CONFLICT
// DO UPDATE), so network reporting across 1,000 stores never scans raw sales.

model DailyStoreStat {
  store              Store    @relation(fields: [storeId], references: [id])
  storeId            String
  date               DateTime @db.Date
  channel            Channel
  sales              Int      @default(0)
  refunds            Int      @default(0)
  units              Int      @default(0)
  grossCents         Int      @default(0) // VAT incl., after discounts
  vatCents           Int      @default(0)
  costCents          Int      @default(0)
  discountCents      Int      @default(0)
  memberSavingsCents Int      @default(0) // instant Rewards (tier/member) savings given
  offerCents         Int      @default(0) // My Deals discounts given (HQ-funded, credited on the statement)
  cardCents          Int      @default(0)
  cashCents          Int      @default(0)
  payshapCents       Int      @default(0)
  eftCents           Int      @default(0)
  loyaltyCents       Int      @default(0)
  onlineCents        Int      @default(0)
  accountCents       Int      @default(0) // trade sales on account (invoiced, not yet money)
  members            Int      @default(0) // transactions linked to a member
  pointsIssued       Int      @default(0)

  @@id([storeId, date, channel])
  @@index([date])
}

model DailyVariantStat {
  store     Store    @relation(fields: [storeId], references: [id])
  storeId   String
  date      DateTime @db.Date
  variantId String
  units     Int      @default(0)
  netCents  Int      @default(0) // VAT excl.
  costCents Int      @default(0)

  @@id([storeId, date, variantId])
  @@index([date])
  @@index([variantId, date])
}

// ───────────────────────────── Network comms ─────────────────────────────

model Announcement {
  id          String            @id @default(cuid())
  title       String
  body        String
  kind        String // NEWS | LAUNCH | POLICY | RECALL
  audience    String // ALL | region:<code> | format:<FORMAT>
  requiresAck Boolean           @default(false)
  createdAt   DateTime          @default(now())
  acks        AnnouncementAck[]
}

model AnnouncementAck {
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String
  store          Store        @relation(fields: [storeId], references: [id])
  storeId        String
  userId         String?
  at             DateTime     @default(now())

  @@id([announcementId, storeId])
}

// ───────────────────────────── Platform ─────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  actorType String // USER | CUSTOMER | DEVICE | SYSTEM
  actorId   String?
  actorName String?
  storeId   String?
  action    String
  entity    String?
  entityId  String?
  data      Json?

  @@index([storeId, at])
  @@index([action])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/** The scheduler's heartbeat: when each job last started, last finished cleanly and last failed (/api/health reads it). */
model JobRun {
  job       String    @id
  startedAt DateTime?
  okAt      DateTime?
  failedAt  DateTime?
  error     String?
}

model Counter {
  key   String @id
  value Int    @default(0)
}

// ── Launch & engagement ─────────────────────────────────────────────────────

/**
 * Web Push subscriptions for the Rewards app (one per browser/device).
 */
model PushSubscription {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

/**
 * Limited releases (apparel, accessories, CBD). Never licensed medicines.
 */
model Drop {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  blurb           String
  variantIds      String[]    @default([])
  startsAt        DateTime
  endsAt          DateTime?
  earlyTier       Tier? // this tier and above get in `earlyMinutes` before everyone else
  earlyMinutes    Int         @default(0)
  perMemberLimit  Int         @default(1)
  membersOnly     Boolean     @default(true)
  notifiedEarlyAt DateTime?
  notifiedAt      DateTime?
  createdAt       DateTime    @default(now())
  watchers        DropWatch[]

  @@index([startsAt])
}

/**
 * "Notify me" for a drop.
 */
model DropWatch {
  drop       Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  dropId     String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  createdAt  DateTime @default(now())

  @@id([dropId, customerId])
}

/**
 * In-store events (opening weekends, members' evenings) with RSVP tickets.
 */
model StoreEvent {
  id        String   @id @default(cuid())
  slug      String   @unique
  store     Store    @relation(fields: [storeId], references: [id])
  storeId   String
  title     String
  blurb     String
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int
  createdAt DateTime @default(now())
  rsvps     Rsvp[]

  @@index([storeId, startsAt])
}

model Rsvp {
  id          String     @id @default(cuid())
  event       StoreEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  code        String     @unique // ticket QR: HHRSVP:{code}
  checkedInAt DateTime?
  createdAt   DateTime   @default(now())

  @@unique([eventId, customerId])
}

/**
 * My Deals: personal, single-use offers loaded to a member's card (HQ-funded). Never on medicines.
 */
model MemberOffer {
  id          String    @id @default(cuid())
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  title       String
  kind        PromoKind // PERCENT | FIXED, targeted at products/categories
  value       Int
  productIds  String[]  @default([])
  categoryIds String[]  @default([])
  startsAt    DateTime
  endsAt      DateTime
  redeemedAt  DateTime?
  saleId      String?
  orderId     String?
  createdAt   DateTime  @default(now())

  @@index([customerId, endsAt])
}

/**
 * Learn quests: points once per article quiz.
 */
model QuestCompletion {
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  key        String
  createdAt  DateTime @default(now())

  @@id([customerId, key])
}

// Posts handed to Postiz for the brand's social accounts (HQ → Campaigns → Social).
model SocialPost {
  id          String    @id @default(cuid())
  content     String
  image       String? // public/social/<image>.jpg
  channels    String[]  @default([]) // "Instagram · herbalholland", as posted; empty when Postiz isn't connected
  mode        String // now | schedule | draft
  scheduledAt DateTime?
  postizIds   String[]  @default([])
  createdBy   String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

// ── Cash banking ────────────────────────────────────────────────────────────
// Cash from closed cash-ups is banked; every deposit carries a photo or PDF of the stamped slip.
model Upload {
  id           String       @id @default(cuid())
  key          String // object key in R2 / S3, or a file under UPLOAD_DIR
  fileName     String
  contentType  String
  sizeBytes    Int
  sha256       String
  storeId      String?
  uploadedById String?
  createdAt    DateTime     @default(now())
  deposit      CashDeposit?
}

enum DepositStatus {
  RECORDED
  VERIFIED
  QUERIED
}

model CashDeposit {
  id            String        @id @default(cuid())
  number        String        @unique
  store         Store         @relation(fields: [storeId], references: [id])
  storeId       String
  bankedOn      DateTime      @db.Date
  amountCents   Int
  expectedCents Int // cash to bank from the cash-ups it covers (counted less float)
  reference     String // deposit reference printed on the slip
  slip          Upload        @relation(fields: [slipId], references: [id])
  slipId        String        @unique
  status        DepositStatus @default(RECORDED)
  note          String?
  createdById   String
  createdAt     DateTime      @default(now())
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  shifts        Shift[]

  @@index([storeId, bankedOn])
  @@index([status])
}

// ── Loss prevention ─────────────────────────────────────────────────────────
enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model Alert {
  id          String        @id @default(cuid())
  key         String        @unique // rule + subject + period: a rule never raises the same alert twice
  rule        String
  severity    AlertSeverity
  store       Store         @relation(fields: [storeId], references: [id])
  storeId     String
  userId      String? // the person it's about — never shown to them
  title       String
  detail      String
  amountCents Int? // value at risk
  evidence    Json // [{ label, href }]
  status      AlertStatus   @default(OPEN)
  note        String?
  closedById  String?
  closedAt    DateTime?
  notifiedAt  DateTime? // high severity: emailed at once; the rest: in the daily digest
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([storeId, status, createdAt])
  @@index([status, createdAt])
  @@index([userId])
}

// ── Commission ──────────────────────────────────────────────────────────────
// An owner's approval freezes a month; `lines` keeps what each person earned (held lines wait for alerts to close).
model CommissionRun {
  id           String   @id @default(cuid())
  store        Store    @relation(fields: [storeId], references: [id])
  storeId      String
  month        String // YYYY-MM (SAST)
  totalCents   Int // payable: excludes held lines
  lines        Json // [{ userId, name, salesCents, refundsCents, commissionCents, held }]
  approvedById String
  approvedAt   DateTime @default(now())

  @@unique([storeId, month])
}

enum LeadStatus {
  NEW
  CONTACTED
  INFO_EVENING
  DISCLOSURE_SENT
  SIGNED
  NOT_A_FIT
}

/// A franchise enquiry from herbalholland.com/franchise, worked by HQ. Personal information (POPIA): HQ only, and
/// not-a-fit enquiries are deleted a year after their last change.
model FranchiseLead {
  id               String     @id @default(cuid())
  number           String     @unique // FL-000123
  name             String
  email            String
  phone            String
  area             String // where they'd like to open
  province         String? // ProvinceCode
  experience       String // their retail or business background
  capital          String // the band they chose (@/lib/leads)
  pharmacist       Boolean // access to a pharmacist partner
  message          String?
  source           String? // ?src= on the enquiry link
  ipHash           String? // keyed hash of the IP, to limit repeat submissions — never the IP itself
  status           LeadStatus @default(NEW)
  ownerId          String? // the HQ person following it up
  notes            String?
  disclosureSentAt DateTime? // CPA franchise regulations: signing no sooner than 14 days after
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([ipHash, createdAt])
}

// ── Member support & returns ─────────────────────────────────────────────────
// A member (or a guest) asks for help at /support; HQ works the inbox (SLA: first reply within 1 business day, resolved
// within 5), store managers see tickets about their own orders. Personal information stays in the ticket (POPIA:
// resolved tickets are deleted a year after they close by the daily job).
enum SupportCategory {
  ORDER
  DELIVERY
  PRODUCT
  REWARDS
  ACCOUNT
  OTHER
}

enum SupportStatus {
  OPEN
  WAITING_MEMBER
  RESOLVED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
}

enum SupportAuthor {
  MEMBER
  STAFF
  SYSTEM
}

model SupportTicket {
  id                 String          @id @default(cuid())
  number             String          @unique // ST-000123, quoted by the member
  customerId         String? // the signed-in member, if any (no relation: tickets outlive anonymised members)
  email              String? // where we reply; a signed-in member without one is texted
  phone              String?
  name               String
  subject            String
  category           SupportCategory
  orderCode          String?
  storeId            String? // the store that fulfilled the order it's about (store managers see these)
  body               String
  status             SupportStatus   @default(OPEN)
  priority           SupportPriority @default(NORMAL)
  assignedToId       String?
  firstResponseDueAt DateTime
  firstRespondedAt   DateTime?
  resolveDueAt       DateTime
  resolvedAt         DateTime?
  ipHash             String? // keyed hash of a guest's IP, to limit repeat submissions — never the IP itself
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  messages SupportMessage[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([storeId, status])
  @@index([assignedToId, status])
  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

model SupportMessage {
  id                 String        @id @default(cuid())
  ticket             SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId           String
  authorType         SupportAuthor
  authorId           String?
  authorName         String? // shown on the thread ("Naledi from Herbal Holland")
  body               String
  attachmentUploadId String? // an Upload (photo) sent with the message
  createdAt          DateTime      @default(now())

  @@index([ticketId, createdAt])
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  COOLING_OFF
  DAMAGED
  OTHER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  COLLECTION_BOOKED
  RECEIVED
  REFUNDED
  DECLINED
}

/// A member's request to return part (or all) of a delivered online order, from the request to the refund. Rules in
/// @/lib/returns (CPA s56 faulty goods, ECTA s44 cooling-off); money moves through refundOrderAmount in @/server/orders.
model ReturnRequest {
  id             String       @id @default(cuid())
  number         String       @unique // RT-000123
  orderId        String
  customerId     String
  storeId        String // the store that fulfilled the order (its back office handles the return)
  reason         ReturnReason
  items          Json // [{ variantId, qty }]
  note           String?
  photoUploadIds String[]     @default([])
  status         ReturnStatus @default(REQUESTED)
  courier        String? // collection booked by hand for now: the courier and its waybill
  waybill        String?
  refundCents    Int? // what was (or will be) refunded, from refundBreakdown()
  refundRef      String? // the gateway's refund id, or the manual refund reference
  decisionNote   String? // why it was declined, or a note with the approval
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([storeId, status])
  @@index([orderId])
}

// ── Operations: staff push, supplier invoices, opening checklist, scheduled exports ──
// Plain id columns (no relations), so these models append without touching the core models above.

/// Web Push subscription for a staff member's phone (one per browser/device): new online orders, low stock,
/// expiring batches, cash to bank, loss alerts about others and HQ updates that need acknowledging.
model StaffPushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String // the subscription's keys
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// Staff pushes already sent (key = event + subject), so a poll never notifies twice; pruned after 60 days.
model StaffPushEvent {
  key    String   @id
  sentAt DateTime @default(now())
}

enum SupplierInvoiceStatus {
  DUE
  PAID
  QUERIED
}

/// A supplier's invoice to a store (DC wholesale, network trading or an outside supplier), with its photo or PDF,
/// captured when the delivery is received or from Finance → Supplier invoices; paid or queried from there.
model SupplierInvoice {
  id           String                @id @default(cuid())
  storeId      String
  supplierName String
  number       String
  invoiceDate  DateTime              @db.Date
  dueDate      DateTime              @db.Date
  totalCents   Int // incl. VAT
  vatCents     Int                   @default(0)
  uploadId     String?               @unique // the Upload holding the photo or PDF (none for a statement invoice)
  stockOrderId String? // the stock order it invoices (onStatement)
  accountId    String? // the ledger account it's charged to (an expense, or stock received at a DC); null = other expenses
  onStatement  Boolean               @default(false) // a stock order (from a DC or another store): its own tax invoice, settled on the month's franchise statement
  status       SupplierInvoiceStatus @default(DUE)
  paidAt       DateTime?
  paidById     String?
  note         String?
  createdById  String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([storeId, status, dueDate])
  @@index([stockOrderId])
}

/// One item of a store's opening checklist (seeded from the template in @/lib/opening when HQ onboards a store).
model StoreTask {
  id        String    @id @default(cuid())
  storeId   String
  key       String
  title     String
  group     String
  sortOrder Int       @default(0)
  dueAt     DateTime?
  doneAt    DateTime?
  doneById  String?
  note      String?
  createdAt DateTime  @default(now())

  @@unique([storeId, key])
  @@index([storeId, doneAt])
}

enum ExportCadence {
  WEEKLY
  MONTHLY
}

/// "Email me this weekly/monthly": a report run by the daily job as the person who scheduled it (their scope),
/// stored as a CSV and sent to staff recipients as a signed download link.
model ScheduledExport {
  id         String        @id @default(cuid())
  userId     String
  reportKey  String
  params     Json // the report's query (scope, stores, range, category, channel…)
  cadence    ExportCadence
  dayOfWeek  Int? // weekly: 1 = Monday … 7 = Sunday (SAST)
  dayOfMonth Int? // monthly: 1–28
  recipients String[]      @default([]) // staff email addresses
  lastRunAt  DateTime?
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@index([userId, reportKey])
  @@index([active, cadence])
}

// ── Shop features (wishlists, vouchers, reminders, wallet) ─────────────────────
// Appended without relations to the core models above (plain id columns, indexed), like the operations block.

/// A product photo: comes in through the catalogue import's `image_urls` column (fetched and kept in storage), served
/// to everyone at /media/[id] while the product is on sale. Ordered by sortOrder; the first is the main picture.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  uploadId  String
  alt       String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([productId, uploadId])
  @@index([productId, sortOrder])
}

/// A member's saved delivery address ("Home", "Work"…); the default one is offered first at checkout.
model Address {
  id         String   @id @default(cuid())
  customerId String
  label      String   @default("Home")
  line       String
  suburb     String
  city       String
  province   Province
  postalCode String
  notes      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, isDefault])
}

/// A variant a member wants to come back to. `outOfStockAt` is set by the frequent job while nothing in the network
/// can ship it; when stock returns it becomes `restockedAt` (the "back in stock" flag on the wishlist).
model Wishlist {
  id           String    @id @default(cuid())
  customerId   String
  variantId    String
  outOfStockAt DateTime?
  restockedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([customerId, variantId])
  @@index([variantId])
}

enum VoucherStatus {
  PENDING // being paid for
  ACTIVE
  REDEEMED // balance used up
  EXPIRED
  CANCELLED
}

/// A gift voucher: money, not an incentive — it pays for anything, including medicines, and carries no bonus value.
/// Bought online as an order for the virtual "Gift voucher" product (@/server/shop/vouchers) and issued when that
/// order is paid; valid for three years from issue (CPA s63(2)); redeemed against orders at checkout.
model GiftVoucher {
  id                    String        @id @default(cuid())
  code                  String        @unique
  amountCents           Int
  balanceCents          Int
  purchasedByCustomerId String?
  purchaseOrderId       String?       @unique
  recipientEmail        String?
  recipientName         String?
  message               String?
  status                VoucherStatus @default(PENDING)
  issuedAt              DateTime?
  expiresAt             DateTime
  redeemedOrderIds      String[]      @default([])
  sentAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([purchasedByCustomerId, createdAt])
  @@index([status, expiresAt])
}

/// Money taken from a voucher: by an online order at checkout (orderId), by a till sale (saleId), or by a counter
/// voucher on a pay-in-store order handed over at the till (both). A cancelled unpaid order marks its rows reversed.
/// A refund puts money back with a negative row against the credit note (saleId, and the order id when there is one):
/// the order-level sums (voucherCentsOf, voucherTenderOf) count only positive rows, so a refund never changes what an
/// order took; the voucher's own rows net to its balance movement.
model VoucherRedemption {
  id        String   @id @default(cuid())
  voucherId String
  orderId   String?
  saleId    String?
  cents     Int
  reversed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([saleId])
  @@index([voucherId])
}

enum ReminderChannel {
  SMS
  EMAIL
  PUSH
}

/// "Remind me to reorder": a schedule the member set for one product (coffee, collagen, oils). The daily job sends a
/// message with a one-tap reorder link on the channel chosen — nothing is charged (no card on file until Peach
/// tokenisation is approved).
model ReorderReminder {
  id         String          @id @default(cuid())
  customerId String
  variantId  String
  everyDays  Int
  nextAt     DateTime
  active     Boolean         @default(true)
  channel    ReminderChannel @default(SMS)
  lastSentAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([customerId, variantId])
  @@index([active, nextAt])
}

// ───────────────────────────── Trade (wholesale) channel ─────────────────────────────
// Businesses that buy at trade prices (ex VAT): online from the DC (EFT up front or on an approved account) and at
// any till (trade-sale mode). Every trade sale posts in the WHOLESALE channel. THC is never traded in this version.

enum TradeAccountStatus {
  PENDING // applied; HQ hasn't approved yet
  APPROVED
  ON_HOLD // overdue, or held by HQ: no new on-account orders
  CLOSED
}

enum TradeTerms {
  PREPAID // EFT before the order is picked
  ACCOUNT // invoiced on shipping, due after paymentDays, within creditLimitCents
}

enum TradeAccountKind {
  PHARMACY
  RETAILER
  CAFE
  PRACTICE // wellness / health practice
  ONLINE_SHOP
  DISTRIBUTOR // wholesaler or distributor: resells to other businesses
  OTHER
}

enum TradeBuyerRole {
  OWNER // may manage buyers and the account's details
  BUYER
}

enum TradeOrderStatus {
  PENDING_PAYMENT // EFT: held (no stock reserved) until HQ confirms the payment
  PLACED // confirmed: DC stock reserved
  PICKING
  READY // click & collect: packed at the store, waiting for the buyer (collection code)
  SHIPPED // courier: invoiced for what shipped; the final state
  COLLECTED // click & collect: handed over at the store and invoiced; the final state
  CANCELLED
}

enum TradeLedgerKind {
  INVOICE // + what the account owes
  PAYMENT // − money received (EFT reference)
  CREDIT_NOTE // − a return or correction
  ADJUSTMENT // ± HQ correction, with a note
}

model TradeAccount {
  id                 String             @id @default(cuid())
  number             String             @unique // TA-000123
  name               String // trading name
  legalName          String
  kind               TradeAccountKind   @default(RETAILER)
  regNumber          String?
  vatNumber          String?
  email              String // billing: pro formas, invoices, statements
  phone              String?
  addressLine        String
  suburb             String?
  city               String
  province           Province
  postalCode         String
  deliveryLine       String? // null = deliver to the billing address
  deliverySuburb     String?
  deliveryCity       String?
  deliveryProvince   Province?
  deliveryPostalCode String?
  status             TradeAccountStatus @default(PENDING)
  terms              TradeTerms         @default(PREPAID)
  paymentDays        Int                @default(30)
  creditLimitCents   Int                @default(0) // ACCOUNT terms: open invoices + unshipped on-account orders may not exceed this
  classes            RegClass[]         @default([]) // what the account may buy (∩ the seller's licences; never THC)
  priceList          PriceList?         @relation(fields: [priceListId], references: [id])
  priceListId        String? // a TRADE price list assigned to this account (null = the active TRADE lists by priority)
  dcId               String? // the warehouse that serves its courier orders (null = the default DC)
  notes              String?
  adultAttestedAt    DateTime? // the applicant confirmed every buyer is 18 or older
  termsVersion       String?
  termsAcceptedAt    DateTime?
  approvedAt         DateTime?
  approvedById       String?
  holdReason         String? // "overdue" and "licence" are the jobs' own holds; they lift themselves
  ipHash             String? // portal applications: a keyed hash of the applicant's IP, for the hourly limit
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  buyers   TradeBuyer[]
  orders   TradeOrder[]
  ledger   TradeLedgerEntry[]
  sales    Sale[]
  licences TradeLicence[]
  cart     TradeCart?

  @@index([status])
  @@index([name])
}

// The account's open cart, shared by its buyers on any device: [{ variantId, qty }] in units (whole cases).
model TradeCart {
  tradeAccount   TradeAccount @relation(fields: [tradeAccountId], references: [id], onDelete: Cascade)
  tradeAccountId String       @id
  items          Json         @default("[]")
  updatedAt      DateTime     @updatedAt
}

model TradeBuyer {
  id             String         @id @default(cuid())
  account        TradeAccount   @relation(fields: [tradeAccountId], references: [id], onDelete: Cascade)
  tradeAccountId String
  name           String
  email          String         @unique // signs in with a code emailed here
  phone          String?
  role           TradeBuyerRole @default(BUYER)
  active         Boolean        @default(true)
  lastSignInAt   DateTime?
  createdAt      DateTime       @default(now())

  sessions Session[]
  orders   TradeOrder[]

  @@index([tradeAccountId])
}

model TradeOrder {
  id             String           @id @default(cuid())
  number         String           @unique // TO-000123
  account        TradeAccount     @relation(fields: [tradeAccountId], references: [id])
  tradeAccountId String
  buyer          TradeBuyer?      @relation(fields: [buyerId], references: [id])
  buyerId        String? // null when HQ placed it for the account
  store          Store            @relation("tradeStore", fields: [storeId], references: [id])
  storeId        String // the fulfilling store: the DC for courier orders, a retail store for click & collect
  fulfilment     Fulfilment       @default(COURIER) // COURIER from the DC, or COLLECT at a store (handling fee)
  status         TradeOrderStatus @default(PENDING_PAYMENT)
  payMethod      PayMethod // EFT (pro forma; held until HQ confirms) or ACCOUNT (within the credit limit)
  paymentRef     String?
  paidAt         DateTime?
  subtotalCents  Int // ex VAT
  deliveryCents  Int              @default(0) // ex VAT (courier)
  handlingCents  Int              @default(0) // ex VAT (click & collect: the store's handling fee)
  vatCents       Int
  totalCents     Int // incl. VAT
  addressLine    String? // courier: where it goes (null for click & collect)
  suburb         String?
  city           String?
  province       Province?
  postalCode     String?
  collectionCode String? // click & collect: shown at the counter with the buyer's ID
  readyAt        DateTime?
  collectedAt    DateTime?
  reference      String? // the buyer's own order / PO number, printed on the invoice
  notes          String?
  courier        String?
  trackingNo     String?
  invoiceNumber  String?          @unique
  sale           Sale?            @relation(fields: [saleId], references: [id])
  saleId         String?          @unique // the WHOLESALE sale posted at the DC when it shipped
  events         Json // [{ status, at, note }]
  reservedAt     DateTime?
  shippedAt      DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  lines TradeOrderLine[]

  @@index([tradeAccountId, status])
  @@index([storeId, status])
  @@index([createdAt])
}

model TradeOrderLine {
  id           String     @id @default(cuid())
  order        TradeOrder @relation(fields: [tradeOrderId], references: [id], onDelete: Cascade)
  tradeOrderId String
  variant      Variant    @relation(fields: [variantId], references: [id])
  variantId    String
  qty          Int // ordered, in case multiples
  unitCents    Int // ex VAT, after quantity breaks
  vatCents     Int // VAT on the ordered quantity
  shippedQty   Int? // null until shipped; short-shipped lines are invoiced for this
  shipped      Json? // [{ batchId, qty }]

  @@index([tradeOrderId])
  @@index([variantId])
}

/// The account's ledger: invoices raise what it owes, payments and credit notes lower it. Balance = sum(cents).
model TradeLedgerEntry {
  id             String          @id @default(cuid())
  account        TradeAccount    @relation(fields: [tradeAccountId], references: [id], onDelete: Cascade)
  tradeAccountId String
  kind           TradeLedgerKind
  cents          Int // signed
  reference      String? // invoice number, bank reference, credit note number
  tradeOrderId   String?
  saleId         String? // the WHOLESALE sale (till or shipped order) an invoice or credit note belongs to
  dueAt          DateTime? // invoices on ACCOUNT terms: when payment is due
  note           String?
  createdById    String?
  createdAt      DateTime        @default(now())

  @@index([tradeAccountId, createdAt])
  @@index([saleId])
  @@index([tradeOrderId])
}

/// The licences and registrations a trade account must hold to buy (src/lib/trade-licences.ts decides which, by the
/// kind of business and the ranges it buys). Submitted with a document at registration or on renewal; HQ verifies
/// each against the issuer before the account may trade, and a lapsed one pauses trading until a renewal is verified.
enum TradeLicenceKind {
  PHARMACY_LICENCE // Pharmacy Act 53 of 1974 s22: the licence to own the pharmacy (Department of Health)
  SAPC_RECORDING // the pharmacy's recording with the South African Pharmacy Council
  SAHPRA_LICENCE // Medicines and Related Substances Act 101 of 1965 s22C: licence to wholesale or distribute medicines
  FOOD_COA // R638 of 2018: certificate of acceptability for food premises (municipal environmental health)
  BUSINESS_LICENCE // Businesses Act 71 of 1991: municipal business licence (meals and perishable foodstuffs)
  PRACTICE_NUMBER // BHF PCNS practice number, with the practitioner's HPCSA or AHPCSA registration
  CIPC_REGISTRATION // the CIPC registration certificate (CoR14.3 or equivalent)
  SARS_REGISTRATION // a sole proprietor's SARS notice of registration (income tax reference number)
}

enum TradeLicenceStatus {
  SUBMITTED // waiting for HQ to check it
  VERIFIED // HQ checked the document against the issuer
  REJECTED // HQ couldn't accept it (reason given); a new one is needed
}

model TradeLicence {
  id             String             @id @default(cuid())
  account        TradeAccount       @relation(fields: [tradeAccountId], references: [id], onDelete: Cascade)
  tradeAccountId String
  kind           TradeLicenceKind
  number         String
  expiresAt      DateTime? // null: it doesn't lapse
  uploadId       String // the document (PDF or photo), served through the app only
  status         TradeLicenceStatus @default(SUBMITTED)
  submittedById  String? // the trade buyer who uploaded it (null: HQ or the seed)
  reviewedAt     DateTime?
  reviewedById   String?
  rejectReason   String?
  remindedAt     DateTime? // the expiry reminder went out
  createdAt      DateTime           @default(now())

  @@index([tradeAccountId, kind])
  @@index([status])
  @@index([expiresAt])
}

// ── Accounting ─────────────────────────────────────────────────────────────────
// One general ledger per company (HQ and every franchisee), stores as a dimension. Journals are posted automatically
// from what happens in the platform (src/server/ledger) and by hand; a posted journal is never edited.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// A company's chart of accounts. System accounts carry the `key` the posting rules use, so renaming one is safe.
model LedgerAccount {
  id        String        @id @default(cuid())
  companyId String
  code      String
  name      String
  type      AccountType
  key       String? // "sales.pos", "vat.output", … (null for accounts the company adds)
  party     String? // control account whose lines name a party: "SUPPLIER" | "TRADE_ACCOUNT" | "COMPANY"
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  lines     JournalLine[]

  @@unique([companyId, code])
  @@unique([companyId, key])
}

enum JournalStatus {
  DRAFT // a manual journal waiting for approval
  POSTED
}

/// A balanced entry in one company's books. Automatic journals name their source; a change to the source posts a
/// further journal with the difference (never an edit), and a manual journal is corrected by its reversal.
model Journal {
  id           String        @id @default(cuid())
  companyId    String
  number       Int // per company, in posting order
  date         DateTime      @db.Date // accounting date (SAST)
  period       String // YYYY-MM of `date`
  source       String // "store-day", "stock-receive", "statement", "bank", "manual", "opening", … (src/lib/ledger SOURCES)
  sourceId     String?
  storeId      String?
  memo         String
  status       JournalStatus @default(POSTED)
  late         Boolean       @default(false) // its own month was closed, so it went into the first open one
  reversalOfId String?       @unique
  createdById  String?
  approvedById String?
  createdAt    DateTime      @default(now())
  lines        JournalLine[]

  @@unique([companyId, number])
  @@index([companyId, source, sourceId])
  @@index([source, sourceId]) // posting looks a source's journals up without the company
  @@index([companyId, period])
  @@index([companyId, status])
}

model JournalLine {
  id          String        @id @default(cuid())
  journal     Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  journalId   String
  companyId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  accountId   String
  storeId     String?
  partyId     String? // supplier name, trade account id or franchisee company id (the account's `party` kind)
  amountCents Int // debit positive, credit negative; a journal's lines sum to zero
  memo        String?
  date        DateTime      @db.Date
  period      String

  @@index([journalId])
  @@index([companyId, accountId, period])
  @@index([companyId, accountId, partyId])
  @@index([companyId, period])
  @@index([accountId])
}

/// Running totals per company × account × store × month, kept in the posting transaction: reports at 1,000 stores read
/// these, not millions of lines.
model LedgerBalance {
  companyId   String
  accountId   String
  storeId     String @default("") // "" = no store
  period      String
  debitCents  BigInt @default(0)
  creditCents BigInt @default(0)

  @@id([companyId, accountId, storeId, period])
  @@index([companyId, period])
}

/// Sources waiting to be posted (or re-posted after a change): queued inside the business transaction, posted every
/// 15 minutes and nightly. Posting is idempotent, so a source queued twice posts once.
model LedgerQueue {
  source   String
  sourceId String
  queuedAt DateTime @default(now())
  attempts Int      @default(0)
  error    String?

  @@id([source, sourceId])
  @@index([queuedAt])
}

/// A payment settling a store's franchise statement: positive = the store paid HQ, negative = HQ paid the store.
model StatementPayment {
  id          String   @id @default(cuid())
  storeId     String
  companyId   String // the store's company
  month       String // YYYY-MM statement it settles
  amountCents Int
  paidOn      DateTime @db.Date
  reference   String
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([storeId, month])
  @@index([companyId])
}

/// A company's bank account, reconciled against its statements; its ledger account carries the balance.
model BankAccount {
  id        String   @id @default(cuid())
  companyId String
  accountId String   @unique // LedgerAccount
  bank      String // FNB | ABSA | STANDARD | NEDBANK | CAPITEC | OTHER
  name      String
  number    String // last digits only
  storeId   String? // the store whose takings are banked here, when one
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([companyId])
}

enum BankLineStatus {
  UNMATCHED
  MATCHED // to a journal already in the books (a deposit, a payout, a payment…)
  ALLOCATED // a journal was posted for it (bank charges, a payment nobody captured…)
  IGNORED
}

/// One line of an imported bank statement. Re-importing the same statement adds nothing (hash).
model BankLine {
  id            String         @id @default(cuid())
  companyId     String
  bankAccountId String
  date          DateTime       @db.Date
  amountCents   Int // money in positive, out negative
  description   String
  reference     String?
  balanceCents  BigInt?
  hash          String
  uploadId      String?
  status        BankLineStatus @default(UNMATCHED)
  journalId     String?
  matchedById   String?
  matchedAt     DateTime?
  createdAt     DateTime       @default(now())

  @@unique([bankAccountId, hash])
  @@index([companyId, status])
  @@index([bankAccountId, date])
  @@index([journalId])
}

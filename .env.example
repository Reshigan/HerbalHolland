# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://hh:hh@127.0.0.1:5432/hh_dev"
DATABASE_POOL_MAX="10"                 # connections per app instance
# 32+ random bytes. Signs hosted invoice links and hashes SA ID numbers.
SESSION_SECRET="dev-only-change-me-32-bytes-minimum-secret"
APP_URL="http://localhost:3000"
# true = demo logins + on-screen OTP codes, for a local demo only. On a server: false. A production server with it off
# won't serve without an https APP_URL and a 32+ character CRON_SECRET; with it on, it won't serve with live payment keys.
DEMO_MODE="true"

# ── Search (docs/SEO.md) ─────────────────────────────────────────────
# "Name|Job title|Registration", e.g. "Jane Doe|Pharmacist|SAPC P12345": shown as "Reviewed by" on Learn guides
# and as Article.reviewedBy. Unset = no reviewer shown (never invent one).
CONTENT_REVIEWER=""
# Official profile URLs for Organization.sameAs, comma-separated. Empty until the profiles exist.
ORG_SAME_AS=""

# ── Email (tax invoices, statements) ─────────────────────────────────
# e.g. smtps://user:pass@email-smtp.af-south-1.amazonaws.com:465 (unset: log to MessageLog)
SMTP_URL=""
EMAIL_FROM="Herbal Holland <invoices@herbalholland.co.za>"
ALERT_EMAIL=""                         # ops inbox for server errors and failed scheduled jobs (throttled); unset = log only
SUPPORT_EMAIL=""                       # where member support mail is sent from/replied to; unset = the built-in default
FRANCHISE_EMAIL=""                     # new franchise leads; unset = franchise@herbalholland.com
TRADE_EMAIL=""                         # new trade applications and licences to check; unset = FRANCHISE_EMAIL

# ── Files: deposit slips, licence documents, photos (docs/RUNBOOK.md → R2) ──
# Cloudflare R2 (EU jurisdiction) or any S3-compatible store. Unset = files on this server under UPLOAD_DIR.
S3_ENDPOINT=""                         # https://<account-id>.eu.r2.cloudflarestorage.com
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
UPLOAD_DIR=""                          # unset = .data/uploads (the Docker image uses /data/uploads)

# ── SMS / WhatsApp ───────────────────────────────────────────────────
MESSAGING_PROVIDER="log"               # log | smsportal
SMSPORTAL_CLIENT_ID=""
SMSPORTAL_API_SECRET=""
SMS_SENDER_ID=""                       # optional, ≤ 11 characters, if approved by SMSPortal
TRANSACTIONAL_CHANNEL="SMS"
OTP_SMS_HOURLY_MAX="500"               # sign-in codes by SMS across the network per hour (a ceiling against SMS pumping)

# ── Rewards app push (npx web-push generate-vapid-keys) ──────────────
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:hello@herbalholland.co.za"

# ── Merch partner: only for a variant made to order (the merch range is held in stock) ───
POD_EMAIL=""                           # the partner's order inbox; empty = logged in HQ → Messages only
# POD_PARTNER_NAME=""                  # the partner's name in production orders (default "our merch partner")

# ── Social: Postiz (free, self-hosted), for HQ → Campaigns → Social ────
POSTIZ_URL=""                          # e.g. https://social.herbalholland.co.za/api/public/v1; empty = posts recorded only
POSTIZ_API_KEY=""                      # Postiz → Settings → Public API
WORKERS_AI_ACCOUNT_ID=""               # optional: Studio rewrites in the brand voice (Cloudflare Workers AI, free allowance)
WORKERS_AI_TOKEN=""                    # a Cloudflare API token with Workers AI read and edit
WORKERS_AI_MODEL=""                    # empty = @cf/meta/llama-3.3-70b-instruct-fp8-fast

# ── Payments ─────────────────────────────────────────────────────────
NEXT_PUBLIC_TAP_PROVIDER="SIMULATED"   # SIMULATED | YOCO (stand-alone Yoco machine) | HALO_APPLINK | EXTERNAL (runtime env only)
HALO_API_URL=""
HALO_API_KEY=""
HALO_MERCHANT_ID=""                    # the network's Halo merchant id; per store: HALO_MERCHANT_ID_<STORECODE> overrides it
ONLINE_GATEWAY="SIMULATED"             # SIMULATED | PEACH (Peach Payments, chosen) | YOCO
PEACH_ENV="test"                       # test (sandbox) | live; switch the three Peach values below with it
PEACH_API_KEY=""                       # Peach Orchestration secret API key: snd_… (sandbox) or prd_… (live)
PEACH_PROFILE_ID=""                    # pro_… (only if the Peach account has more than one business profile)
PEACH_PAYMENT_RESPONSE_HASH_KEY=""     # the profile's payment_response_hash_key: verifies /api/payments/peach
YOCO_SECRET_KEY=""                     # Yoco Checkout API: sk_test_… (testing) or sk_live_… (after domain verification)
YOCO_WEBHOOK_SECRET=""                 # whsec_… returned when /api/payments/yoco was registered with the same mode's key

# ── Scheduler ────────────────────────────────────────────────────────
CRON_SECRET=""                         # 32+ random characters (openssl rand -hex 32): Authorization: Bearer for /api/cron/*

# ── Corporate site (herbalholland.com Worker → HQ franchise leads) ───
SITE_ENQUIRY_SECRET=""                 # the Worker's APP_ENQUIRY_SECRET; unset = enquiries stay with the Worker's email

# ── Wallet passes (optional; docs/INTEGRATIONS.md) ───────────────────
WALLET_APPLE_PASS_TYPE_ID=""
WALLET_APPLE_TEAM_ID=""
WALLET_APPLE_CERT_PEM=""
WALLET_APPLE_KEY_PEM=""
WALLET_APPLE_WWDR_PEM=""
WALLET_GOOGLE_ISSUER_ID=""
WALLET_GOOGLE_SERVICE_ACCOUNT_JSON=""

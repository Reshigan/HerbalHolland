# Herbal Holland on Cloudflare Workers (docs/CLOUDFLARE.md). This file is for a laptop: copy it to `.env`, which
# `next dev`, the seed, `scripts/*.ts` and vitest read. The live Worker reads nothing from a file:
#   secrets (keys, passwords, anything private)  →  `wrangler secret put NAME`  (one at a time; it prompts for the value)
#   plain settings (DEMO_MODE, APP_URL, EMAIL_FROM, provider choices, ceilings)  →  `vars` in wrangler.jsonc
# Both reach the app as `process.env.NAME`. The database (D1), files (R2) and the browser are bindings in wrangler.jsonc,
# not variables. `npm run start` (wrangler preview) reads secrets from `.dev.vars` in the same NAME=value form.

# ── Core ─────────────────────────────────────────────────────────────
# Local tools only (never the Worker): the SQLite file the seed, scripts and vitest open. Next to `next dev` that is
# the local D1 file: DATABASE_URL=file:$(ls .wrangler/state/v3/d1/miniflare-D1DatabaseObject/*.sqlite)
DATABASE_URL="file:./.wrangler/state/v3/d1/miniflare-D1DatabaseObject/local.sqlite"
# 32+ random bytes (openssl rand -base64 48). Signs hosted invoice links and hashes SA ID numbers. Secret.
SESSION_SECRET="dev-only-change-me-32-bytes-minimum-secret"
APP_URL="http://localhost:3000"
# true = demo logins + on-screen OTP codes, for a local demo only. Live: false (wrangler.jsonc vars). With it off the
# Worker won't serve without an https APP_URL and a 32+ character CRON_SECRET; with it on, it won't serve with live
# payment keys (every request answers 500 and the log says why).
DEMO_MODE="true"

# ── Search (docs/SEO.md) ─────────────────────────────────────────────
# "Name|Job title|Registration", e.g. "Jane Doe|Pharmacist|SAPC P12345": shown as "Reviewed by" on Learn guides
# and as Article.reviewedBy. Unset = no reviewer shown (never invent one).
CONTENT_REVIEWER=""
# Official profile URLs for Organization.sameAs, comma-separated. Empty until the profiles exist.
ORG_SAME_AS=""

# ── Email: Microsoft 365 through Graph (tax invoices, statements, campaigns) ──
# An Entra app with Graph Mail.Send (application, admin consent), ideally limited to the sending mailbox by an Exchange
# ApplicationAccessPolicy. It sends as the address in EMAIL_FROM. Unset: every email is only written to the message log.
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""                    # secret; rotate in Entra → App registrations → Certificates & secrets
EMAIL_FROM="Herbal Holland <invoices@herbalholland.com>"
ALERT_EMAIL=""                         # ops inbox for errors and failed scheduled jobs (throttled); unset = log only
SUPPORT_EMAIL=""                       # where member support mail is sent from/replied to; unset = the built-in default
FRANCHISE_EMAIL=""                     # new franchise leads; unset = franchise@herbalholland.com
TRADE_EMAIL=""                         # new trade applications and licences to check; unset = FRANCHISE_EMAIL

# ── SMS / WhatsApp ───────────────────────────────────────────────────
MESSAGING_PROVIDER="log"               # log | smsportal
SMSPORTAL_CLIENT_ID=""                 # secret
SMSPORTAL_API_SECRET=""                # secret
SMS_SENDER_ID=""                       # optional, ≤ 11 characters, if approved by SMSPortal
TRANSACTIONAL_CHANNEL="SMS"
OTP_SMS_HOURLY_MAX="500"               # sign-in codes by SMS across the network per hour (a ceiling against SMS pumping)

# ── Rewards app push (npx web-push generate-vapid-keys) ──────────────
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""                # secret
WEB_PUSH_SUBJECT="mailto:hello@herbalholland.com"

# ── Merch partner: only for a variant made to order (the merch range is held in stock) ───
POD_EMAIL=""                           # the partner's order inbox; empty = logged in HQ → Messages only
# POD_PARTNER_NAME=""                  # the partner's name in production orders (default "our merch partner")

# ── Social: Postiz, for HQ → Campaigns → Social ─────────────────────
POSTIZ_URL=""                          # e.g. https://social.herbalholland.com/api/public/v1; empty = posts recorded only
POSTIZ_API_KEY=""                      # secret; Postiz → Settings → Public API
WORKERS_AI_ACCOUNT_ID=""               # optional: Studio rewrites in the brand voice (Cloudflare Workers AI, free allowance)
WORKERS_AI_TOKEN=""                    # secret; a Cloudflare API token with Workers AI read and edit
WORKERS_AI_MODEL=""                    # empty = @cf/meta/llama-3.3-70b-instruct-fp8-fast

# ── Payments ─────────────────────────────────────────────────────────
NEXT_PUBLIC_TAP_PROVIDER="SIMULATED"   # SIMULATED | YOCO (stand-alone Yoco machine) | HALO_APPLINK | EXTERNAL (runtime env only)
HALO_API_URL=""
HALO_API_KEY=""                        # secret
HALO_MERCHANT_ID=""                    # the network's Halo merchant id; per store: HALO_MERCHANT_ID_<STORECODE> overrides it
ONLINE_GATEWAY="SIMULATED"             # SIMULATED | PEACH (Peach Payments, chosen) | YOCO
PEACH_ENV="test"                       # test (sandbox) | live; switch the three Peach values below with it
PEACH_API_KEY=""                       # secret; Peach Orchestration API key: snd_… (sandbox) or prd_… (live)
PEACH_PROFILE_ID=""                    # pro_… (only if the Peach account has more than one business profile)
PEACH_PAYMENT_RESPONSE_HASH_KEY=""     # secret; the profile's payment_response_hash_key: verifies /api/payments/peach
YOCO_SECRET_KEY=""                     # secret; Yoco Checkout API: sk_test_… (testing) or sk_live_… (after domain verification)
YOCO_WEBHOOK_SECRET=""                 # secret; whsec_… returned when /api/payments/yoco was registered with the same mode's key

# ── Scheduled jobs (Cron Triggers in wrangler.jsonc call /api/cron/*) ──
CRON_SECRET=""                         # secret; 32+ random characters (openssl rand -hex 32): Authorization: Bearer for /api/cron/*

# ── Corporate site (herbalholland.com Worker → HQ franchise leads) ───
SITE_ENQUIRY_SECRET=""                 # secret; the Worker's APP_ENQUIRY_SECRET; unset = the endpoint refuses everything

# ── Wallet passes (optional; docs/INTEGRATIONS.md) ───────────────────
WALLET_APPLE_PASS_TYPE_ID=""
WALLET_APPLE_TEAM_ID=""
WALLET_APPLE_CERT_PEM=""
WALLET_APPLE_KEY_PEM=""                # secret
WALLET_APPLE_WWDR_PEM=""
WALLET_GOOGLE_ISSUER_ID=""
WALLET_GOOGLE_SERVICE_ACCOUNT_JSON=""  # secret

# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://hh:hh@127.0.0.1:5432/hh_dev"
DATABASE_POOL_MAX="10"                 # connections per app instance
# 32+ random bytes. Signs hosted invoice links and hashes SA ID numbers.
SESSION_SECRET="dev-only-change-me-32-bytes-minimum-secret"
APP_URL="http://localhost:3000"
# true = demo logins + on-screen OTP codes. MUST be false in production.
DEMO_MODE="true"

# ── Search (docs/SEO.md) ─────────────────────────────────────────────
# "Name|Job title|Registration", e.g. "Jane Doe|Pharmacist|SAPC P12345": shown as "Reviewed by" on Learn guides
# and as Article.reviewedBy. Unset = no reviewer shown (never invent one).
CONTENT_REVIEWER=""
# Official profile URLs for Organization.sameAs, comma-separated. Empty until the profiles exist.
ORG_SAME_AS=""

# ── Email (tax invoices, statements) ─────────────────────────────────
# e.g. smtps://user:pass@email-smtp.af-south-1.amazonaws.com:465 — unset = log to MessageLog
SMTP_URL=""
EMAIL_FROM="Herbal Holland <invoices@herbalholland.co.za>"

# ── SMS / WhatsApp ───────────────────────────────────────────────────
MESSAGING_PROVIDER="log"               # log | smsportal
SMSPORTAL_CLIENT_ID=""
SMSPORTAL_API_SECRET=""
SMS_SENDER_ID=""                       # optional, ≤ 11 characters, if approved by SMSPortal
TRANSACTIONAL_CHANNEL="SMS"
OTP_SMS_HOURLY_MAX="500"               # sign-in codes by SMS across the network per hour (a ceiling against SMS pumping)

# ── Rewards app push (npx web-push generate-vapid-keys) ──────────────
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:hello@herbalholland.co.za"

# ── Merch partner: made-to-order merch, production orders by email ───
POD_EMAIL=""                           # the partner's order inbox; empty = logged in HQ → Messages only
POD_PARTNER_NAME="Lucani"

# ── Social: Postiz (free, self-hosted) — HQ → Campaigns → Social ────
POSTIZ_URL=""                          # e.g. https://social.herbalholland.co.za/api/public/v1; empty = posts recorded only
POSTIZ_API_KEY=""                      # Postiz → Settings → Public API

# ── Payments ─────────────────────────────────────────────────────────
NEXT_PUBLIC_TAP_PROVIDER="SIMULATED"   # SIMULATED | YOCO (stand-alone Yoco machine) | HALO_APPLINK | EXTERNAL — runtime env only
HALO_API_URL=""
HALO_API_KEY=""
ONLINE_GATEWAY="SIMULATED"             # SIMULATED | PEACH (Peach Payments, chosen) | YOCO
PEACH_ENV="test"                       # test (sandbox) | live — switch the three Peach values below with it
PEACH_API_KEY=""                       # Peach Orchestration secret API key: snd_… (sandbox) or prd_… (live)
PEACH_PROFILE_ID=""                    # pro_… — only if the Peach account has more than one business profile
PEACH_PAYMENT_RESPONSE_HASH_KEY=""     # the profile's payment_response_hash_key: verifies /api/payments/peach
YOCO_SECRET_KEY=""                     # Yoco Checkout API: sk_test_… (testing) or sk_live_… (after domain verification)
YOCO_WEBHOOK_SECRET=""                 # whsec_… returned when /api/payments/yoco was registered with the same mode's key

# ── Scheduler ────────────────────────────────────────────────────────
CRON_SECRET=""

// herbalholland.com: static pages from dist/ (npx tsx sites/herbalholland.com/build.ts) + worker.ts for /api/*.
// Pushes to main deploy it (.github/workflows/deploy-site.yml). By hand, from this folder with CLOUDFLARE_API_TOKEN set:
//   npx wrangler@4 d1 migrations apply herbalholland-com-eu --remote && npx wrangler@4 deploy
// Secrets (wrangler secret put): NOTIFY_TO (a verified Email Routing destination), IP_SALT; once the platform is live,
// APP_ENQUIRY_URL (https://herbalholland.co.za/api/site/enquiries) and APP_ENQUIRY_SECRET (= the app's SITE_ENQUIRY_SECRET).
{
  "name": "herbalholland-com",
  "account_id": "08596e523c096f04b56d7ae43f7821f4",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "tsconfig": "../../tsconfig.json",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "herbalholland-com-eu", "database_id": "8e145c20-d05a-4c4f-84f1-013a82b8846f", "migrations_dir": "migrations" }
  ],
  "send_email": [{ "name": "MAILER" }],
  "triggers": { "crons": ["15 0 * * *"] }, // 02:15 SAST: delete enquiries kept long enough (worker.ts scheduled)
  "vars": { "NOTIFY_FROM": "website@herbalholland.com" },
  "routes": [{ "pattern": "herbalholland.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}

// herbalholland.com: static pages from dist/ (npx tsx sites/herbalholland.com/build.ts) + worker.ts for /api/* and the
// old franchise page's addresses (a 301 to /about).
// Pushes to main deploy it (.github/workflows/deploy-site.yml). By hand, from this folder with CLOUDFLARE_API_TOKEN set:
//   npx wrangler@4 d1 migrations apply herbalholland-com-eu --remote && npx wrangler@4 deploy
// Secrets (wrangler secret put): IP_SALT.
{
  "name": "herbalholland-com",
  "account_id": "08596e523c096f04b56d7ae43f7821f4",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "tsconfig": "../../tsconfig.json",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The franchise page's old addresses match no asset, so a browser opening one would get the 404 page without the
    // Worker running: it runs first for them, to redirect.
    "run_worker_first": ["/api/*", "/franchise", "/franchise/", "/franchise.html"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "herbalholland-com-eu", "database_id": "8e145c20-d05a-4c4f-84f1-013a82b8846f", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["15 0 * * *"] }, // 02:15 SAST: delete enquiries kept long enough (worker.ts scheduled)
  "routes": [{ "pattern": "herbalholland.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}

# Postiz's settings on the server (copy to .env, which is never committed). Each secret: openssl rand -hex 32
JWT_SECRET=""
POSTIZ_DB_PASSWORD=""
TEMPORAL_DB_PASSWORD=""

# false until HQ's Postiz account is created, then true (and docker compose up -d again)
DISABLE_REGISTRATION="false"

# One Meta developer app owned by HQ: Facebook and Instagram (a professional account); Threads has its own ID and secret
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
# LinkedIn page posting, once LinkedIn approves the Community Management API
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Telegram: a bot from @BotFather (its username without the @), made admin of the channel; one Postiz per bot
TELEGRAM_BOT_NAME=""
TELEGRAM_TOKEN=""
# Bluesky needs nothing here: connect it in Postiz with an app password.

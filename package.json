{
  "name": "herbal-holland",
  "version": "0.1.0",
  "private": true,
  "description": "Herbal Holland commerce platform: POS, inventory, finance, e-commerce, loyalty and marketing for a multi-owner store network in South Africa.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 edge versions",
    "last 2 firefox versions",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "start": "opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate || true",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "deploy": "opennextjs-cloudflare deploy",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:diff": "prisma migrate diff --from-local-d1 --to-schema=prisma/schema.prisma --script"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.0",
    "lucide-react": "1.48.0",
    "next": "^16.4.2",
    "nodemailer": "^10.0.10",
    "pg": "8.23.0",
    "playwright-core": "1.63.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "1.63.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "18.0.4",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}
